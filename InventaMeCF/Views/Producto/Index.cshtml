@model InventaMeCF.Models.ProductoMarcaModelView
@using InventaMeCF.Utilidades

@{
    ViewData["Title"] = "Productos";

    Paginacion paginacion = new Paginacion();
    int paginaActual = 0;

    if (ViewBag.Paginacion != null)
    {
        paginacion = ViewBag.Paginacion;
        paginaActual = paginacion.PaginaActual;
    }


    string cadenaString = Context.Request.Query["cadenaString"].ToString();
    string productoMarca = Context.Request.Query["productoMarca"].ToString();
}

<form asp-action="Index" method="get" class="mb-4">

    <div class="row">

      
        <div class="col-md-5">
            <label class="form-label">Buscar producto</label>

            <input type="text"
                   name="cadenaString"
                   value="@cadenaString"
                   class="form-control"
                   placeholder="Nombre del producto..." />
        </div>

    
        <div class="col-md-5">
            <label class="form-label">Marca</label>

            <select name="productoMarca" class="form-select">

                <option value="0">Todas las marcas</option>

                @foreach (var marca in Model.Marcas)
                {
                    <option value="@marca.Value"
                            selected="@(marca.Value == productoMarca ? "selected" : null)">
                        @marca.Text
                    </option>
                }

            </select>
        </div>

  
        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">
                Filtrar
            </button>
        </div>

    </div>

</form>



<table class="table">

    <thead>
        <tr>
            <th>
                Nombre
            </th>

            <th>
                Precio
            </th>

            <th>
                Acciones
            </th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model.Productos)
        {
            <tr>

                <td>
                    @Html.DisplayFor(modelItem => item.Nombre)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.PrecioUnitario)
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id">
                        Edit
                    </a>
                    |
                    <a asp-action="Details"
                       asp-route-id="@item.Id">
                        Details
                    </a>
                    |
                    <a asp-action="Delete"
                       asp-route-id="@item.Id">
                        Delete
                    </a>
                </td>

            </tr>
        }

    </tbody>

</table>


@if (paginacion.TotalPaginas > 1)
{
    <nav>
        <ul class="pagination">

           
            @if (paginaActual > 1)
            {
                <li class="page-item">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pg="@(paginaActual - 1)"
                       asp-route-cadenaString="@cadenaString"
                       asp-route-productoMarca="@productoMarca">

                        Anterior

                    </a>

                </li>
            }


         
            @for (int i = paginacion.PaginaInicio;
                       i <= paginacion.UltimaPagina;
                       i++)
            {
                <li class="page-item @(i == paginaActual ? "active" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pg="@i"
                       asp-route-cadenaString="@cadenaString"
                       asp-route-productoMarca="@productoMarca">

                        @i

                    </a>

                </li>
            }


            @if (paginaActual < paginacion.TotalPaginas)
            {
                <li class="page-item">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pg="@(paginaActual + 1)"
                       asp-route-cadenaString="@cadenaString"
                       asp-route-productoMarca="@productoMarca">

                        Siguiente

                    </a>

                </li>
            }

        </ul>
    </nav>
}

<br />  

<a asp-controller="Producto" asp-action="GraficoVolumenVentasPdf" asp-route-n="3">Volumen de ventas</a>

<br />

<form asp-controller="Producto" asp-action="ExportarXLSX" method="post" class="mt-3">
    <button type="submit" class="btn btn-success">
        Exportar a Excel
    </button>
</form>