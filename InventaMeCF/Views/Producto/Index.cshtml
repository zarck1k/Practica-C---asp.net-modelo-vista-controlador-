@model InventaMeCF.Models.ProductoMarcaModelView
@using InventaMeCF.Utilidades

@{
    ViewData["Title"] = "Productos";

    Paginacion paginacion = new Paginacion();
    int paginaActual = 0;

    if (ViewBag.Paginacion != null)
    {
        paginacion = ViewBag.Paginacion;
        paginaActual = paginacion.PaginaActual;
    }
}

<h1>Productos</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                Nombre
            </th>
            <th>
                Precio Unitario
            </th>
            <th>
                Acciones
            </th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Productos)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Nombre)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.PrecioUnitario)
                </td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (paginacion.TotalPaginas > 1)
{
    <nav>
        <ul class="pagination">

            @if (paginaActual > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pg="@(paginaActual - 1)">
                        Anterior
                    </a>
                </li>
            }

            @for (int i = paginacion.PaginaInicio; i <= paginacion.UltimaPagina; i++)
            {
                <li class="page-item @(i == paginaActual ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pg="@i">
                        @i
                    </a>
                </li>
            }

            @if (paginaActual < paginacion.TotalPaginas)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pg="@(paginaActual + 1)">
                        Siguiente
                    </a>
                </li>
            }

        </ul>
    </nav>
}